<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        style="@style/Screen"
        android:layout_height="wrap_content">

        <TextView
            style="@style/Small"
            android:layout_marginTop="0dp"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/state"
            style="@style/Headline"
            android:text="@string/checking" />

        <TextView
            android:id="@+id/details"
            style="@style/Small" />

        <Button
            android:id="@+id/install"
            style="@style/Action"
            android:layout_marginTop="8dp"
            android:text="@string/install_fix" />

        <Button
            android:id="@+id/undo"
            style="@style/Action"
            android:text="@string/undo_fix" />

        <Button
            android:id="@+id/toggle"
            style="@style/Action"
            android:text="@string/toggle" />

        <Button
            android:id="@+id/root_mode"
            style="@style/Action"
            android:text="@string/root_mode_button" />

        <Button
            android:id="@+id/boot_notify"
            style="@style/Action"
            android:text="@string/notify_main_button" />

        <Button
            android:id="@+id/bounce_filter"
            style="@style/Action"
            android:text="@string/bounce_filter_button" />

        <Button
            android:id="@+id/tester"
            style="@style/Action"
            android:text="@string/tester_title" />

        <Button
            android:id="@+id/log"
            style="@style/Action"
            android:text="@string/log_title" />

        <!-- Small link to the source; focusable so the D-pad can reach it. -->
        <TextView
            android:id="@+id/repo_link"
            style="@style/Small"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="4dp"
            android:text="@string/repo_link" />
    </LinearLayout>
</ScrollView>
